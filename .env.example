PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
DEMO_MODE=true
# Optional: where the SQLite file lives (use a persistent disk path in production)
# SOURCE_DB_PATH=/var/data/source-store.sqlite
# Optional: public feed poll interval in ms (60000 - 86400000, default 900000)
# SOURCE_POLL_INTERVAL_MS=900000
# Market Impact module (all optional)
# TIINGO_API_TOKEN=      # US stock/ETF daily prices; free plan is non-commercial/internal use
# FRED_API_KEY=          # S&P 500, Nasdaq, Dow, Brent, WTI daily series
# MARKET_SYNC_DISABLED=1 # stop background price fetching
# Map workspace (all optional; no keys are needed for USGS, EONET or GDACS)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # base map; https only. Default is OpenStreetMap standard tiles
# MAP_TILE_ATTRIBUTION=                                         # required text/HTML for a custom provider
# MAP_TILE_PROVIDER=                                            # display name for a custom provider
# MAP_TILE_MAX_ZOOM=18
# USGS_FEED_LEVEL=4.5            # significant | 4.5 | 2.5 | 1.0 (minimum magnitude of the USGS summary feed)
# MAP_SYNC_DISABLED=1            # stop background USGS/EONET fetching (saved-area alerts keep running)
# ADSB_DISABLED=1                # switch the aircraft layer off
# ADSB_REFRESH_MS=15000          # aircraft refresh, clamped to 5000-120000
# ADSB_API_BASE=https://api.adsb.lol
# ADSB_CONTACT_CONFIRMED=1       # set once you have contacted ADSB.lol about production use (hides the setup note)
# MAP_COUNTRY_BOUNDARIES_URL=    # GeoJSON with ISO_A2 properties; default is Natural Earth 110m via jsDelivr
# MAP_COUNTRY_BOUNDARIES_DISABLED=1

# AI features (all optional; see docs/AI.md). No paid AI service is used or allowed.
# No-install route: Cloudflare Workers AI, Free plan (10,000 neurons/day, hard stop, no charge). Set these in Render, never in code:
# AI_PROVIDER=cloudflare
# AI_CLOUDFLARE_ACCOUNT_ID=                     # 32-character Account ID
# AI_API_KEY=                                   # API token with the "Workers AI" permission
# AI_ALLOW_PRIVATE_RECORDS=1                    # only if you accept sending incidents/assessments/places to Cloudflare (default: public reports only)
# Own-computer route (Ollama):
# AI_BASE_URL=https://your-tunnel.example.com   # https + AI_API_KEY for a remote computer; http://127.0.0.1:11434 for the same machine
# AI_API_KEY=                                   # the secret you also give tools/ollama-gateway.mjs. Server-side only, never in code
# AI_MODEL=qwen3:4b                             # Ollama: or qwen3:8b. Cloudflare default: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_ENABLED=0                                  # switch AI off for everyone
# AI_AUTO_ENRICH=critical-high                  # off | critical-high | all (summaries of new reports while the model is idle)
# AI_TIMEOUT_MS=180000
# AI_CONCURRENCY=1
# AI_QUEUE_LIMIT=8
